<UserControl x:Class="AuraFlow.App.Controls.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- Saturation / Value box -->
        <Grid x:Name="SvBox" Width="236" Height="150" Cursor="Cross" ClipToBounds="True">
            <Rectangle x:Name="HueBackdrop" RadiusX="8" RadiusY="8"/>
            <Rectangle RadiusX="8" RadiusY="8">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FFFFFFFF" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle RadiusX="8" RadiusY="8">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0"/>
                        <GradientStop Color="#FF000000" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Canvas x:Name="SvCapture" Background="Transparent" MouseLeftButtonDown="Sv_MouseDown"
                    MouseMove="Sv_MouseMove" MouseLeftButtonUp="Sv_MouseUp"/>
            <Ellipse x:Name="SvThumb" Width="13" Height="13" Stroke="White" StrokeThickness="2.5"
                     IsHitTestVisible="False" Panel.ZIndex="2" Fill="Transparent"
                     HorizontalAlignment="Left" VerticalAlignment="Top"/>
        </Grid>

        <!-- Hue -->
        <Slider x:Name="HueSlider" Style="{StaticResource HueSlider}" Minimum="0" Maximum="360"
                Margin="0,12,0,4" ValueChanged="Hue_ValueChanged"/>

        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="26" Height="26" CornerRadius="7" BorderBrush="#33FFFFFF" BorderThickness="1"
                    x:Name="CurrentSwatch" VerticalAlignment="Center"/>
            <TextBox x:Name="HexBox" Grid.Column="1" Margin="9,0,0,0" MaxLength="7"
                     KeyDown="HexBox_KeyDown" LostFocus="HexBox_LostFocus"/>
        </Grid>

        <!-- Presets -->
        <ItemsControl x:Name="PresetsList" Margin="0,11,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ItemsPresenter/>
                </ControlTemplate>
            </ItemsControl.Template>
        </ItemsControl>
    </StackPanel>
</UserControl>
