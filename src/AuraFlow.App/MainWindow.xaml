<Window x:Class="AuraFlow.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AuraFlow.App.ViewModels"
        xmlns:models="clr-namespace:AuraFlow.App.Models"
        xmlns:ctrl="clr-namespace:AuraFlow.App.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="AuraFlow" Width="1120" Height="700" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg.Base}"
        ResizeMode="CanResize" ShowInTaskbar="True">

    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <vm:BoolToVis x:Key="BoolToVis"/>
        <vm:InverseBoolToVis x:Key="InverseBoolToVis"/>
        <vm:StatusBrush x:Key="StatusBrush"/>
        <vm:EffectTypeToVis x:Key="EffectTypeToVis"/>
        <vm:NullToVis x:Key="NullToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= Title bar ================= -->
        <Grid Grid.Row="0" Background="{StaticResource Bg.Panel}">
            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <Ellipse Width="13" Height="13">
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF5A6CFF" Offset="0"/>
                            <GradientStop Color="#FFB06DFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock Text="AuraFlow" FontWeight="SemiBold" FontSize="13.5" Margin="9,0,0,0"
                           Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center"/>
                <TextBlock Text="v1.0" FontSize="11" Margin="8,1,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource Text.Disabled}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Top">
                <Button Style="{StaticResource IconButton}" Content="&#xE921;" FontFamily="Segoe MDL2 Assets"
                        Click="Minimize_Click" ToolTip="Minimize"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE922;" FontFamily="Segoe MDL2 Assets"
                        Click="Maximize_Click" ToolTip="Maximize"/>
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets"
                        Click="Close_Click" ToolTip="Close to tray"/>
            </StackPanel>
        </Grid>

        <!-- ================= Body ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource Bg.Panel}"
                    BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,0,1,0">
                <DockPanel Margin="10,14,10,12">
                    <Button DockPanel.Dock="Bottom" Command="{Binding BackFromSettingsCommand}"
                            Visibility="{Binding SettingsPageVisible, Converter={StaticResource BoolToVis}}"
                            Content="&#8592;  Back to devices" HorizontalContentAlignment="Left" Margin="0,6,0,0"/>
                    <Button DockPanel.Dock="Bottom" Command="{Binding ShowSettingsCommand}"
                            Visibility="{Binding SettingsPageVisible, Converter={StaticResource InverseBoolToVis}}"
                            HorizontalContentAlignment="Left" Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="  Settings" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <StackPanel>
                        <TextBlock Text="DEVICES" Style="{StaticResource SectionLabel}" Margin="4,2,0,8"/>
                        <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,8" Background="Transparent">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="32" Height="32" CornerRadius="8"
                                                    Background="{StaticResource Bg.Input}">
                                                <TextBlock Text="{Binding TypeIcon}" FontSize="15"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{StaticResource Accent.Brush}"/>
                                            </Border>
                                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="12.5"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="130"
                                                           Foreground="{StaticResource Text.Primary}"/>
                                                <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="130"
                                                           Foreground="{StaticResource Text.Secondary}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Enabled}" Value="False">
                                            <Setter Property="Opacity" Value="0.45"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Main area -->
            <Grid Grid.Column="1" Margin="18,16,18,10">

                <!-- ============ Device page ============ -->
                <Grid Visibility="{Binding SettingsPageVisible, Converter={StaticResource InverseBoolToVis}}">

                    <!-- Empty state -->
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HasDevices, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="&#xF158;" FontFamily="Segoe MDL2 Assets" FontSize="42"
                                   HorizontalAlignment="Center" Foreground="{StaticResource Border.Strong}"/>
                        <TextBlock Text="No devices detected yet" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,14,0,0"
                                   Foreground="{StaticResource Text.Primary}"/>
                        <TextBlock TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380" Margin="0,8,0,0"
                                   Foreground="{StaticResource Text.Secondary}"
                                   Text="Waiting for the OpenRGB server. Make sure it is installed and running as administrator - check Settings if the problem persists."/>
                        <Button Command="{Binding ShowSettingsCommand}" Content="Open Settings" Margin="0,18,0,0"
                                HorizontalAlignment="Center" Style="{StaticResource AccentButton}"/>
                    </StackPanel>

                    <!-- Device content -->
                    <Grid Visibility="{Binding HasDevices, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="2,0,2,14">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="42" Height="42" CornerRadius="11" Background="{StaticResource Bg.Card}">
                                    <TextBlock Text="{Binding SelectedDevice.TypeIcon}" FontSize="19"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource Accent.Brush}"/>
                                </Border>
                                <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedDevice.Title}" Style="{StaticResource H1}"
                                               FontSize="17"/>
                                    <TextBlock Text="{Binding SelectedDevice.Subtitle}" FontSize="11.5" Margin="0,3,0,0"
                                               Foreground="{StaticResource Text.Secondary}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="Control this device" FontSize="12" Margin="0,1,10,0"
                                           VerticalAlignment="Center" Foreground="{StaticResource Text.Secondary}"/>
                                <CheckBox IsChecked="{Binding SelectedDevice.Enabled}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="360"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="390"/>
                            </Grid.ColumnDefinitions>

                            <!-- Preview card -->
                            <Border Grid.Column="0" Background="{StaticResource Bg.Card}"
                                    BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1"
                                    CornerRadius="12" Padding="18">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="LIVE PREVIEW" Style="{StaticResource SectionLabel}"/>
                                        <ItemsControl ItemsSource="{Binding SelectedDevice.Zones}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,16">
                                                        <TextBlock Text="{Binding Name}" FontSize="11" Margin="1,0,0,7"
                                                                   Foreground="{StaticResource Text.Secondary}"/>
                                                        <ItemsControl ItemsSource="{Binding Dots}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Ellipse Width="17" Height="17" Margin="0,0,6,6"
                                                                             Fill="{Binding Brush}"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- Layers card -->
                            <Border Grid.Column="2" Margin="16,0,0,0" Background="{StaticResource Bg.Card}"
                                    BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1"
                                    CornerRadius="12" Padding="18">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <TextBlock Text="LIGHTING LAYERS" Style="{StaticResource SectionLabel}"
                                                   VerticalAlignment="Center"/>
                                        <Button x:Name="AddLayerButton" HorizontalAlignment="Right"
                                                Style="{StaticResource AccentButton}" Padding="11,5"
                                                Content="+  Add layer" Click="AddLayer_Click"/>
                                    </Grid>

                                    <ListBox Grid.Row="1" x:Name="LayersList" MaxHeight="190"
                                             ItemsSource="{Binding SelectedDevice.Layers}"
                                             SelectedItem="{Binding SelectedDevice.SelectedLayer}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="2,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Style="{StaticResource MiniCheck}" IsChecked="{Binding Enabled}"
                                                              VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding TypeDisplay}" FontSize="12.5"
                                                               VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                        <Button Style="{StaticResource IconButton}" Width="26" Height="24"
                                                                Content="&#xE74A;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                                Click="MoveLayerUp_Click" ToolTip="Move up (front)"/>
                                                        <Button Style="{StaticResource IconButton}" Width="26" Height="24"
                                                                Content="&#xE74B;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                                Click="MoveLayerDown_Click" ToolTip="Move down (behind)"/>
                                                        <Button Style="{StaticResource IconButton}" Width="26" Height="24"
                                                                Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                                Click="DeleteLayer_Click" ToolTip="Delete layer"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!-- Layer editor -->
                                    <ScrollViewer Grid.Row="3" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="LayerEditor"
                                                    Visibility="{Binding SelectedDevice.SelectedLayer, Converter={StaticResource NullToVis}}">
                                            <TextBlock Text="EFFECT TYPE" Style="{StaticResource SectionLabel}"/>
                                            <ComboBox ItemsSource="{x:Static models:EffectOption.All}"
                                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                                      SelectedValue="{Binding SelectedDevice.SelectedLayer.Type}"/>

                                            <!-- Colors row -->
                                            <StackPanel Margin="0,15,0,0"
                                                        Visibility="{Binding SelectedDevice.SelectedLayer.Type, Converter={StaticResource EffectTypeToVis}, ConverterParameter=Static|Breathing|Blink}">
                                                <Grid Margin="0,0,0,7">
                                                    <TextBlock Text="COLORS" Style="{StaticResource SectionLabel}"
                                                               VerticalAlignment="Center"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button Style="{StaticResource IconButton}" Width="26" Height="24"
                                                                Content="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                                Click="AddColor_Click" ToolTip="Add color"/>
                                                        <Button Style="{StaticResource IconButton}" Width="26" Height="24"
                                                                Content="&#xE738;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                                Click="RemoveColor_Click" ToolTip="Remove selected color"/>
                                                    </StackPanel>
                                                </Grid>
                                                <ItemsControl x:Name="SwatchesList" ItemsSource="{Binding SelectedDevice.SelectedLayer.Colors}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Width="30" Height="30" Margin="0,0,8,8" Click="Swatch_Click"
                                                                    BorderThickness="2" Cursor="Hand">
                                                                <Button.Background>
                                                                    <SolidColorBrush Color="{Binding MediaColor}"/>
                                                                </Button.Background>
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="bd" CornerRadius="8"
                                                                                Background="{TemplateBinding Background}"
                                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                                BorderThickness="{TemplateBinding BorderThickness}"/>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="bd" Property="BorderBrush" Value="White"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <!-- Sliders -->
                                            <StackPanel Margin="0,15,0,0"
                                                        Visibility="{Binding SelectedDevice.SelectedLayer.Type, Converter={StaticResource EffectTypeToVis}, ConverterParameter=RainbowCycle|RainbowWave|Breathing|Blink}">
                                                <TextBlock Text="SPEED" Style="{StaticResource SectionLabel}"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="46"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Slider Minimum="0" Maximum="100"
                                                            Value="{Binding SelectedDevice.SelectedLayer.Speed}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding SelectedDevice.SelectedLayer.Speed, StringFormat={}{0:F0}%}"
                                                               VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11.5"
                                                               Foreground="{StaticResource Text.Secondary}"/>
                                                </Grid>
                                            </StackPanel>

                                            <StackPanel Margin="0,15,0,0">
                                                <TextBlock Text="BRIGHTNESS" Style="{StaticResource SectionLabel}"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="46"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Slider Minimum="0" Maximum="100"
                                                            Value="{Binding SelectedDevice.SelectedLayer.Brightness}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding SelectedDevice.SelectedLayer.Brightness, StringFormat={}{0:F0}%}"
                                                               VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11.5"
                                                               Foreground="{StaticResource Text.Secondary}"/>
                                                </Grid>
                                            </StackPanel>

                                            <CheckBox Margin="0,15,0,0" Content="Reverse direction"
                                                      Visibility="{Binding SelectedDevice.SelectedLayer.Type, Converter={StaticResource EffectTypeToVis}, ConverterParameter=RainbowCycle|RainbowWave}"
                                                      IsChecked="{Binding SelectedDevice.SelectedLayer.Reverse}"/>

                                            <StackPanel Margin="0,15,0,0"
                                                        Visibility="{Binding SelectedDevice.SelectedLayer.Type, Converter={StaticResource EffectTypeToVis}, ConverterParameter=RainbowWave}">
                                                <TextBlock Text="WAVE DENSITY" Style="{StaticResource SectionLabel}"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="46"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Slider Minimum="0.25" Maximum="8" IsSnapToTickEnabled="True" TickFrequency="0.25"
                                                            Value="{Binding SelectedDevice.SelectedLayer.WaveCycles}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding SelectedDevice.SelectedLayer.WaveCycles, StringFormat={}{0:0.##}x}"
                                                               VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11.5"
                                                               Foreground="{StaticResource Text.Secondary}"/>
                                                </Grid>
                                            </StackPanel>

                                            <StackPanel Margin="0,15,0,0"
                                                        Visibility="{Binding SelectedDevice.SelectedLayer.Type, Converter={StaticResource EffectTypeToVis}, ConverterParameter=Blink}">
                                                <TextBlock Text="ON-TIME" Style="{StaticResource SectionLabel}"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="46"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Slider Minimum="5" Maximum="95"
                                                            Value="{Binding SelectedDevice.SelectedLayer.DutyCycle}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding SelectedDevice.SelectedLayer.DutyCycle, StringFormat={}{0:F0}%}"
                                                               VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11.5"
                                                               Foreground="{StaticResource Text.Secondary}"/>
                                                </Grid>
                                            </StackPanel>

                                            <!-- Color picker flyout -->
                                            <Border x:Name="ColorEditorPanel" Visibility="Collapsed" Margin="0,16,0,0"
                                                    Background="{StaticResource Bg.Panel}" CornerRadius="10" Padding="13"
                                                    BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,9">
                                                        <TextBlock Text="EDIT COLOR" Style="{StaticResource SectionLabel}"
                                                                   VerticalAlignment="Center"/>
                                                        <Button Style="{StaticResource IconButton}" Width="26" Height="24"
                                                                HorizontalAlignment="Right" Content="&#xE711;"
                                                                FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                                Click="CloseColorEditor_Click"/>
                                                    </Grid>
                                                    <ctrl:ColorPicker x:Name="LayerColorPicker" ColorChanged="Picker_ColorChanged"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ============ Settings page ============ -->
                <ScrollViewer Visibility="{Binding SettingsPageVisible, Converter={StaticResource BoolToVis}}"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="620" HorizontalAlignment="Left">

                        <TextBlock Text="Settings" Style="{StaticResource H1}" Margin="2,0,0,16"/>

                        <!-- OpenRGB card -->
                        <Border Background="{StaticResource Bg.Card}" BorderBrush="{StaticResource Border.Subtle}"
                                BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="OPENRGB SERVER" Style="{StaticResource SectionLabel}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                             Fill="{Binding ExeFound, Converter={StaticResource StatusBrush}}"/>
                                    <TextBlock Text="{Binding ResolvedExe}" FontSize="12" Margin="9,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource Text.Secondary}"/>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding OpenRgbPath, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Browse�" Margin="9,0,0,0" Click="BrowseExe_Click"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
                                    <Button Style="{StaticResource AccentButton}" Content="Install OpenRGB automatically"
                                            Command="{Binding InstallOpenRgbCommand}"/>
                                    <Button Content="Restart server" Margin="9,0,0,0"
                                            Command="{Binding RestartServerCommand}"/>
                                </StackPanel>

                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding InstallProgress}" Margin="0,13,0,0"
                                             Visibility="{Binding Installing, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="{Binding InstallStatus}" FontSize="12" Margin="0,9,0,0" TextWrapping="Wrap"
                                           Foreground="{StaticResource Text.Secondary}"/>

                                <!-- Diagnostics -->
                                <Separator Margin="0,15"/>
                                <TextBlock Text="STATUS" Style="{StaticResource SectionLabel}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                             Fill="{Binding ServerUp, Converter={StaticResource StatusBrush}}"/>
                                    <TextBlock Text="OpenRGB SDK server running" FontSize="12.5" Margin="9,0,0,0"
                                               VerticalAlignment="Center" Foreground="{StaticResource Text.Primary}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                             Fill="{Binding Connected, Converter={StaticResource StatusBrush}}"/>
                                    <TextBlock Text="AuraFlow connected to server" FontSize="12.5" Margin="9,0,0,0"
                                               VerticalAlignment="Center" Foreground="{StaticResource Text.Primary}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                             Fill="{Binding HasDevices, Converter={StaticResource StatusBrush}}"/>
                                    <TextBlock FontSize="12.5" Margin="9,0,0,0" VerticalAlignment="Center"
                                               Foreground="{StaticResource Text.Primary}">
                                        <Run Text="Devices detected: "/><Run Text="{Binding DeviceCount, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Text="{Binding DiagnosticHint}" FontSize="11.5" TextWrapping="Wrap"
                                           Foreground="{StaticResource Text.Secondary}"/>

                                <Separator Margin="0,15"/>

                                <Grid Margin="0,3,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Elevated logon task" FontSize="13"
                                                   Foreground="{StaticResource Text.Primary}"/>
                                        <TextBlock Text="Starts the server at login with admin rights - no UAC prompt."
                                                   FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap"
                                                   Foreground="{StaticResource Text.Secondary}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,8,0"
                                                 Fill="{Binding TaskRegistered, Converter={StaticResource StatusBrush}}"/>
                                        <Button Content="Register" Click="RegisterTask_Click"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Behavior card -->
                        <Border Background="{StaticResource Bg.Card}" BorderBrush="{StaticResource Border.Subtle}"
                                BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="BEHAVIOR" Style="{StaticResource SectionLabel}"/>

                                <TextBlock Text="Effect frame rate" FontSize="13" Foreground="{StaticResource Text.Primary}"/>
                                <Grid Margin="0,8,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="52"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="5" Maximum="60" Value="{Binding Fps}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Fps, StringFormat={}{0:F0} fps}"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11.5"
                                               Foreground="{StaticResource Text.Secondary}"/>
                                </Grid>
                                <TextBlock Text="Lower = less CPU. Static colors cost almost nothing either way."
                                           FontSize="11.5" Margin="0,2,0,0" Foreground="{StaticResource Text.Disabled}"/>

                                <CheckBox Margin="0,15,0,0" Content="Start minimized to tray"
                                          IsChecked="{Binding StartMinimized}"/>
                                <CheckBox Margin="0,13,0,0" Content="Start with Windows"
                                          IsChecked="{Binding Autostart}"/>
                            </StackPanel>
                        </Border>

                        <!-- About card -->
                        <Border Background="{StaticResource Bg.Card}" BorderBrush="{StaticResource Border.Subtle}"
                                BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="ABOUT" Style="{StaticResource SectionLabel}"/>
                                <TextBlock FontSize="12" TextWrapping="Wrap" LineHeight="19"
                                           Foreground="{StaticResource Text.Secondary}"
                                           Text="AuraFlow is a lightweight lighting controller for your GPU and motherboard, driven by a headless OpenRGB server. Typical footprint: ~60-90 MB RAM and near-zero CPU for static colors. Keyboard-reactive 'Type Lighting' and more effects are planned."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ================= Status bar ================= -->
        <Border Grid.Row="2" Background="{StaticResource Bg.Panel}"
                BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,1,0,0" Padding="14,0">
            <Grid Height="30">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{Binding Connected, Converter={StaticResource StatusBrush}}"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource Text.Secondary}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="{StaticResource Danger.Brush}" CornerRadius="5" Padding="7,2"
                            Visibility="{Binding Blackout, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="LIGHTS OFF" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                    </Border>
                    <TextBlock Text="{Binding Fps, StringFormat={}{0:F0} FPS}" FontSize="11.5" Margin="12,0,0,0"
                               VerticalAlignment="Center" Foreground="{StaticResource Text.Disabled}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>



